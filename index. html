    </header>

    <nav>
        <a href="#">Beranda</a>
        <a href="#">Artikel</a>
        <a href="#">Tentang</a>
    </nav>

    <div class="container">

        <img
            class="gambar-artikel"
            src="https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=1000&q=80"
