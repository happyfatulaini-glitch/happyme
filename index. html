</body>/* Tampilan seluruh halaman */
body {
    font-family: Arial, sans-serif;
    margin: 0;
    background: #f1f7ee;
    color: #333;
    line-height: 1.8;
}

/* Header */
header {
    background: linear-gradient(135deg, #14532d, #4d9b58);
    color: white;
    text-align: center;
    padding: 25px;
}

/* Menu navigasi */
nav {
    background: #174a2b;
    text-align: center;
    padding: 15px;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 15px;
    font-weight: bold;
}

nav a:hover {
    color: #b7f7a5;
}

/* Kotak artikel */
.container {
    max-width: 850px;
    margin: 30px auto;
    padding: 25px;
    background: white;
    border-radius: 15px;
    box-shadow: 0 5px 15px #ccc;
}

/* Gambar artikel */
.gambar-artikel {
    width: 100%;
    height: 300px;
    object-fit: cover;
    border-radius: 10px;
}

/* Judul artikel */
h2 {
    color: #1b5e20;
    border-left: 5px solid #66bb6a;
    padding-left: 12px;
}

h3 {
    color: #2e7d32;
}

/* Informasi penulis */
.info {
    color: #777;
    font-size: 14px;
    border-bottom: 1px solid #ddd;
    padding-bottom: 10px;
}

/* Tombol artikel */
.tombol {
    display: inline-block;
    background: #2e7d32;
    color: white;
    text-decoration: none;
    padding: 10px 20px;
    border-radius: 8px;
    margin-top: 10px;
}

.tombol:hover {
    background: #14532d;
}

/* Footer */
footer {
    background: #174a2b;
    color: white;
    text-align: center;
    padding: 15px;
}

/* Tampilan HP */
@media (max-width: 600px) {
    .container {
        margin: 15px;
        padding: 15px;
    }

    header h1 {
        font-size: 27px;
    }

    nav a {
        margin: 5px;
    }

    .gambar-artikel {
        height: 220px;
    }
}
